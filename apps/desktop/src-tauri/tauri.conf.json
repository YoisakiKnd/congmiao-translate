{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Congmiao Translate",
  "version": "0.1.0",
  "identifier": "app.congmiao.translate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "从喵翻译",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#f3f3f3"
      },
      {
        "label": "popup",
        "title": "从喵翻译",
        "url": "popup.html",
        "width": 420,
        "height": 520,
        "minWidth": 320,
        "minHeight": 180,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' https: http:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["congmiao"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNUZGQjlDQ0Y2ODAwQ0MKUldUTUFHalBuUHRmMElBd3ZFV1Q2L2lnekxaZk55bENlSXpSY3gzNExHbW54MDdWSk5ITC9SK1AK",
      "endpoints": [
        "https://github.com/YoisakiKnd/congmiao-translate/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/congmiao-daemon",
      "binaries/congmiao-host"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "xclip",
          "xdotool",
          "tesseract-ocr",
          "tesseract-ocr-chi-sim",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
